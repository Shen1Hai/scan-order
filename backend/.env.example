# 扫码点单系统 - 环境配置文件
# 复制此文件为 .env 并修改相应配置

# ============ 应用配置 ============
APP_NAME=扫码点单系统
APP_VERSION=1.0.0
DEBUG=true
PORT=8000

# ============ 数据库配置 ============
# PostgreSQL 配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=scanorder

# ============ JWT 配置 ============
# JWT 密钥 (生产环境务必修改为复杂随机字符串)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ CORS 配置 ============
# 允许的源 (多个用逗号分隔)
CORS_ORIGINS=*

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_DIR=./logs
