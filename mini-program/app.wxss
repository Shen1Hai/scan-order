/**
 * 扫码点单小程序 - 全局样式
 */
page {
  background-color: #f5f5f5;
  font-size: 14px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 按钮样式 */
.btn-primary {
  background-color: #07c160;
  color: #fff;
  border: none;
  border-radius: 25px;
}

.btn-primary:active {
  background-color: #05903a;
}

.btn-secondary {
  background-color: #fff;
  color: #07c160;
  border: 1px solid #07c160;
  border-radius: 25px;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

/* 价格样式 */
.price {
  color: #ff4d4f;
  font-weight: 600;
}

.price::before {
  content: '¥';
  font-size: 12px;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 12px;
}

.tag-success {
  background-color: #e8f8ee;
  color: #07c160;
}

.tag-warning {
  background-color: #fff7e6;
  color: #fa8c16;
}

.tag-info {
  background-color: #e6f7ff;
  color: #1890ff;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 24px;
  color: #999;
}

.empty-state .icon {
  font-size: 64px;
  margin-bottom: 16px;
}
