/* pages/menu/menu.wxss */
.container {
  min-height: 100vh;
  padding-bottom: 70px;
  background: #f5f5f5;
}

.category-tabs {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #fff;
  white-space: nowrap;
  z-index: 100;
  border-bottom: 1px solid #eee;
}

.category-tab {
  display: inline-block;
  padding: 12px 16px;
  font-size: 14px;
  color: #999;
  border-bottom: 2px solid transparent;
}

.category-tab.active {
  color: #07c160;
  border-bottom-color: #07c160;
}

.dish-list {
  padding-top: 44px;
  padding: 44px 12px 80px;
}

.dish-item {
  display: flex;
  background: #fff;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.dish-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  margin-left: 12px;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.dish-desc {
  font-size: 12px;
  color: #999;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.dish-price {
  font-size: 18px;
  color: #ff4d4f;
  font-weight: 600;
}

.dish-actions {
  display: flex;
  align-items: center;
}

.dish-count {
  min-width: 24px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
}

.btn-add,
.btn-minus {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.btn-minus {
  background: #f5f5f5;
  color: #666;
}

.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: #333;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
}

.cart-info {
  display: flex;
  align-items: center;
  color: #fff;
}

.cart-icon {
  font-size: 24px;
  margin-right: 8px;
}

.cart-count {
  min-width: 20px;
  height: 20px;
  background: #ff4d4f;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  padding: 0 6px;
  margin-right: 12px;
}

.cart-total {
  font-size: 18px;
  font-weight: 600;
}

.btn-checkout {
  width: 100px;
  height: 44px;
  background: #07c160;
  color: #fff;
  border-radius: 22px;
  font-size: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}
