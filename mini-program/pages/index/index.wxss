/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #07c160, #00a65a);
}

.home-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100px;
}

.home-header {
  text-align: center;
  margin-bottom: 60px;
}

.logo {
  font-size: 80px;
  margin-bottom: 16px;
}

.title {
  display: block;
  font-size: 32px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8px;
}

.subtitle {
  color: rgba(255, 255, 255, 0.9);
  font-size: 16px;
}

.scan-section {
  width: 80%;
  margin-bottom: 24px;
}

.btn-scan {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 50px;
  background: #fff;
  color: #07c160;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 500;
}

.btn-scan .icon {
  font-size: 20px;
}

.input-section {
  width: 80%;
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}

.table-input {
  flex: 1;
  height: 44px;
  background: #fff;
  border-radius: 22px;
  padding: 0 20px;
  font-size: 14px;
}

.btn-confirm {
  width: 80px;
  height: 44px;
  background: #fff;
  color: #07c160;
  border-radius: 22px;
  font-size: 14px;
}

.hint {
  color: rgba(255, 255, 255, 0.8);
  font-size: 14px;
  text-decoration: underline;
}

.table-info {
  padding: 20px;
}

.info-card {
  background: #fff;
  border-radius: 12px;
  padding: 24px;
  text-align: center;
  margin-bottom: 24px;
}

.table-name {
  display: block;
  font-size: 24px;
  font-weight: 600;
  margin-bottom: 8px;
}

.table-status {
  color: #999;
  font-size: 14px;
}

.btn-start {
  width: 100%;
  height: 50px;
  background: #fff;
  color: #07c160;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 500;
}
