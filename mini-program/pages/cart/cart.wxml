<!--pages/cart/cart.wxml-->
<view class="container">
  <!-- 购物车列表 -->
  <view class="cart-list">
    <view
      wx:for="{{cart}}"
      wx:key="dish_id"
      class="cart-item"
    >
      <view class="item-info">
        <text class="item-name">{{item.dish_name}}</text>
        <text class="item-price">¥{{item.price}} × {{item.quantity}}</text>
      </view>
      <view class="item-actions">
        <text
          class="btn-minus"
          bindtap="removeFromCart"
          data-id="{{item.dish_id}}"
        >−</text>
        <text class="item-count">{{item.quantity}}</text>
        <text
          class="btn-add"
          bindtap="addToCart"
          data-id="{{item.dish_id}}"
        >+</text>
      </view>
    </view>

    <view class="empty-state" wx:if="{{!cart.length}}">
      <text class="icon">🛒</text>
      <text>购物车是空的</text>
      <button class="btn-browse" bindtap="goToMenu">去点餐</button>
    </view>
  </view>

  <!-- 订单确认 -->
  <view class="order-section" wx:if="{{cart.length > 0}}">
    <view class="table-info">
      <text>桌号: {{tableName}}</text>
    </view>
    <view class="order-total">
      <text>合计:</text>
      <text class="total-amount">¥{{total}}</text>
    </view>
    <button class="btn-submit" bindtap="submitOrder">提交订单</button>
  </view>
</view>
