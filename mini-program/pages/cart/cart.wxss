/* pages/cart/cart.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 12px;
}

.cart-list {
  margin-bottom: 200px;
}

.cart-item {
  display: flex;
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  align-items: center;
}

.item-info {
  flex: 1;
}

.item-name {
  display: block;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.item-price {
  font-size: 14px;
  color: #999;
}

.item-actions {
  display: flex;
  align-items: center;
}

.item-count {
  min-width: 24px;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
}

.btn-add,
.btn-minus {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.btn-minus {
  background: #f5f5f5;
  color: #666;
}

.order-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16px;
  border-top: 1px solid #eee;
}

.table-info {
  margin-bottom: 12px;
  color: #666;
  font-size: 14px;
}

.order-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  font-size: 16px;
}

.total-amount {
  font-size: 24px;
  font-weight: 600;
  color: #ff4d4f;
}

.btn-submit {
  width: 100%;
  height: 48px;
  background: #07c160;
  color: #fff;
  border-radius: 24px;
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-browse {
  margin-top: 20px;
  background: #07c160;
  color: #fff;
  border-radius: 20px;
}
