/* pages/orders/orders.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 12px;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #eee;
}

.order-no {
  font-size: 14px;
  color: #999;
}

.order-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 4px;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-paid,
.status-preparing {
  background: #e6f7ff;
  color: #1890ff;
}

.status-ready {
  background: #f6ffed;
  color: #07c160;
}

.status-completed {
  background: #f5f5f5;
  color: #999;
}

.status-cancelled {
  background: #fff1f0;
  color: #ff4d4f;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
  color: #666;
  margin-bottom: 12px;
}

.order-footer {
  text-align: right;
}

.order-total {
  font-size: 18px;
  font-weight: 600;
  color: #ff4d4f;
}
