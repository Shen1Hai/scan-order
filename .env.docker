# Docker 环境配置示例
# 复制为 .env 后修改使用

# ============ 应用配置 ============
APP_NAME=扫码点单系统
APP_VERSION=1.0.0
DEBUG=false
PORT=8000

# ============ 数据库配置 ============
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=scanorder

# ============ JWT 配置 ============
SECRET_KEY=your-secret-key-change-in-production-docker
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============ 存储配置 ============
STORAGE_TYPE=local

# ============ CORS 配置 ============
CORS_ORIGINS=*

# ============ 日志配置 ============
LOG_LEVEL=INFO
